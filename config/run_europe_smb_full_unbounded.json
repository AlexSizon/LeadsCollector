{
  "_comment": "Europe SMB full run with a practical no-cap setting for lead collection",
  "_data_source": "OpenStreetMap Overpass API (Google Places API key not configured)",

  "countries": ["Spain", "Netherlands", "Portugal"],

  "cities": [
    "Madrid", "Barcelona", "Valencia", "Seville", "Malaga",
    "Amsterdam", "Rotterdam", "Utrecht", "The Hague", "Eindhoven",
    "Lisbon", "Porto", "Braga", "Faro", "Coimbra"
  ],

  "city_country_map": {
    "Madrid": "Spain",
    "Barcelona": "Spain",
    "Valencia": "Spain",
    "Seville": "Spain",
    "Malaga": "Spain",
    "Amsterdam": "Netherlands",
    "Rotterdam": "Netherlands",
    "Utrecht": "Netherlands",
    "The Hague": "Netherlands",
    "Eindhoven": "Netherlands",
    "Lisbon": "Portugal",
    "Porto": "Portugal",
    "Braga": "Portugal",
    "Faro": "Portugal",
    "Coimbra": "Portugal"
  },

  "niches": [
    "restaurant",
    "beauty salon",
    "beauty studio",
    "gift shop",
    "florist",
    "bakery",
    "boutique",
    "cosmetics shop",
    "specialty food shop",
    "pet shop",
    "home decor shop",
    "craft store"
  ],

  "language_priority": ["en", "es", "nl", "pt"],

  "max_results_per_query": 1000,

  "min_reviews_threshold": 0,
  "min_rating_threshold": 0.0,

  "include_instagram_analysis": true,
  "run_website_audit": true,

  "enable_social_discovery": true,
  "enable_contact_discovery": true,
  "enable_tripadvisor_discovery": true,
  "enable_email_guesser": true,
  "social_request_delay": 3.0,

  "output_format": "json",
  "request_delay": 3.0,
  "terminal_verbosity": "normal",
  "terminal_summary_every_queries": 10,

  "output": {
    "json": "output/leads_full_unbounded.json",
    "csv": "output/leads_full_unbounded.csv",
    "summary": "output/run_summary_full_unbounded.md"
  }
}
